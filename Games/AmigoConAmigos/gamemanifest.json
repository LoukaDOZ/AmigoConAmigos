    "4": 0.063
  },
  "buttons": [ //Define which function to call when clicking the button with this name in Unity
    {
      "objectName": "PlayButton", //Play button must call TryStartGame
      "functionName": "TryStartGame"
    }
  ],
  "fields": []
}